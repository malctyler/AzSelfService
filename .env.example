# AzSelfService Platform — Environment Template
# Copy this to .env and fill in values for local development

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=azselfservice
DB_USER=postgres
DB_PASSWORD=postgres_dev_password_123!

# Connection String (constructed from above)
# Format: Server=HOST;Port=PORT;Database=DB_NAME;User Id=DB_USER;Password=DB_PASSWORD;
CONNECTION_STRING=Server=postgres;Port=5432;Database=azselfservice;User Id=postgres;Password=postgres_dev_password_123!

# ============================================================================
# JWT / Authentication Configuration
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-for-prod
JWT_ISSUER=https://azselfservice.example.com
JWT_AUDIENCE=azselfservice-api
JWT_EXPIRATION_HOURS=24

# ============================================================================
# Azure Configuration
# ============================================================================
# Used for Key Vault, Blob Storage, etc.

AZURE_SUBSCRIPTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=replace-me-for-local-dev-only
AZURE_KEYVAULT_NAME=azselfservice-1338-kv
AZURE_KEYVAULT_URL=https://azselfservice-1338-kv.vault.azure.net/

# Storage Account for Terraform State
AZURE_STORAGE_ACCOUNT_NAME=tfstate12345
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key-here
AZURE_STORAGE_CONTAINER_NAME=tfstate

# ============================================================================
# Terraform Configuration
# ============================================================================
TERRAFORM_VERSION=1.5.0
TERRAFORM_MODULES_PATH=./terraform-modules
TERRAFORM_WORKING_DIR=/tmp/terraform

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=Debug
LOG_PATH=./logs

# ============================================================================
# API Configuration
# ============================================================================
API_PORT=5000
API_BASE_URL=http://localhost:5000
API_CORS_ORIGIN=http://localhost:3000

# ============================================================================
# Frontend Configuration
# ============================================================================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# ============================================================================
# Feature Flags (Post-MVP)
# ============================================================================
FEATURE_APPROVALS_ENABLED=false
FEATURE_RBAC_ENABLED=false
FEATURE_DRIFT_DETECTION_ENABLED=false

# ============================================================================
# Docker Compose Configuration
# ============================================================================
# Used by docker-compose.yml
COMPOSE_PROJECT_NAME=azselfservice
POSTGRES_PASSWORD=postgres_dev_password_123!
POSTGRES_DB=azselfservice

# ============================================================================
# Development Configuration
# ============================================================================
# Local development only
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# ============================================================================
# Notes
# ============================================================================
# - Replace all "your-" values with actual values
# - Never commit .env file with real secrets
# - Use Azure Key Vault for production secrets
# - For local development: these defaults work with docker-compose up

